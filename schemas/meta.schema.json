{
  "type": "object",
  "required": [
    "schema_version",
    "region",
    "crs",
    "origin",
    "start_date",
    "osm_date",
    "dataset_version",
    "network_kinds"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "crs": {
      "enum": [
        "EPSG:25830",
        "EPSG:4083"
      ]
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "start_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "osm_date": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "network_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "high_speed",
          "conventional",
          "narrow_gauge",
          "metro",
          "tram"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ancho-iberico/meta",
  "title": "meta"
}
