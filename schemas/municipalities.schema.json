{
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "type": {
      "const": "FeatureCollection"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "Feature"
          },
          "geometry": {
            "type": "object",
            "required": [
              "type",
              "coordinates"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array"
              }
            }
          },
          "properties": {
            "type": "object",
            "required": [
              "code",
              "name",
              "population"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[0-9]{5}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "population": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ancho-iberico/municipalities",
  "title": "municipalities"
}
