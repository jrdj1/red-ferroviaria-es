{
  "type": "object",
  "required": [
    "schema_version",
    "stations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "alt_names",
          "municipality_code",
          "network_kinds",
          "importance",
          "x",
          "y"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n_[a-z2-7]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "alt_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "municipality_code": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{5}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "network_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "high_speed",
                "conventional",
                "narrow_gauge",
                "metro",
                "tram"
              ]
            }
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ancho-iberico/stations",
  "title": "stations"
}
